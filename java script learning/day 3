let subjects = [maths, physics, chemistry, english, computerScience];
let passed = true;

for (let i = 0; i < subjects.length; i++) {
    if (subjects[i] < 35) {
        passed = false;
        break;
    }
}

if (passed) {
    console.log("Result : PASS ");
} else {
    console.log("Result : FAIL ");
