
let studentName = "Karthik";
let rollNo = 101;

let maths = 88;
let physics = 91;
let chemistry = 79;
let english = 85;
let computerScience = 95;
let total = maths + physics + chemistry + english + computerScience;
let percentage = total / 5;

let grade;

if (percentage >= 90) {
    grade = "A+";
} else if (percentage >= 80) {
    grade = "A";
} else if (percentage >= 70) {
    grade = "B";
} else if (percentage >= 60) {
    grade = "C";
} else if (percentage >= 50) {
    grade = "D";
} else {
    grade = "Fail";
}

// Display Result
console.log("==================================");
