# ==============================================================================
# WorkPulse - Environment Configuration Template
# Copy this file to .env in the root and in the respective subfolders if running locally.
# ==============================================================================

# Database Connection (Prisma)
DATABASE_URL="postgresql://workpulse_user:workpulse_password@localhost:5432/workpulse_db?schema=public"

# Backend Network Configuration
PORT=3001
FRONTEND_URL="http://localhost:3000"

# JWT Security Secrets (Please change in production)
JWT_ACCESS_SECRET="super_secret_access_token_key_123!"
JWT_REFRESH_SECRET="super_secret_refresh_token_key_456!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# GitHub API Integration Configuration
# If left blank, the application automatically runs in "mock simulation mode"
# to generate beautiful, interactive developer activity charts out-of-the-box.
GITHUB_TOKEN=""

# Node Environment
NODE_ENV="development"
