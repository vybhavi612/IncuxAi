// 10. Count Digits
console.log("10. Count Digits");
let num1 = 12345;
let count = 0;
while (num1 > 0) {
    count++;
    num1 = Math.floor(num1 / 10);
}
console.log(count);

// 11. Sum of Digits
console.log("11. Sum of Digits");
let num2 = 1234;
let digitSum = 0;
while (num2 > 0) {
    digitSum += num2 % 10;
    num2 = Math.floor(num2 / 10);
}
console.log(digitSum);

// 12. Reverse a Number
console.log("12. Reverse Number");
let num3 = 1234;
let reverse = 0;
while (num3 > 0) {
    reverse = reverse * 10 + (num3 % 10);
    num3 = Math.floor(num3 / 10);
}
console.log(reverse);

// 13. Check Palindrome
console.log("13. Palindrome Check");
let num4 = 121;
let temp = num4;
let rev = 0;

while (temp > 0) {
    rev = rev * 10 + (temp % 10);
    temp = Math.floor(temp / 10);
}

if (num4 === rev) {
    console.log("Palindrome");
} else {
    console.log("Not Palindrome");
}

// 14. Fibonacci Series
console.log("14. Fibonacci Series");
let a = 0, b = 1;
console.log(a);
console.log(b);

for (let i = 3; i <= 10; i++) {
    let c = a + b;
    console.log(c);
    a = b;
    b = c;
}

// 15. Prime Number Check
console.log("15. Prime Number Check");
let primeNum = 13;
let isPrime = true;

for (let i = 2; i < primeNum; i++) {
    if (primeNum % i === 0) {
        isPrime = false;
        break;
    }
}

if (isPrime) {
    console.log("Prime");
} else {
    console.log("Not Prime");
}

