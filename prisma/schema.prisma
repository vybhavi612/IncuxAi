generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String       @id @default(uuid())
  role         String       // "STUDENT" or "ADMIN"
  name         String
  email        String       @unique
  passwordHash String
  phone        String?
  studentId    String?      // Optional for ADMIN
  course       String?      // Optional for ADMIN
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendances  Attendance[]
}

model Attendance {
  id               String   @id @default(uuid())
  userId           String
  date             String   // YYYY-MM-DD
  loginTime        DateTime
  logoutTime       DateTime?
  isLate           Boolean
  lateDelayMinutes Int      @default(0)
  totalHours       Float    @default(0)

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // A user has only one attendance record per day
}
